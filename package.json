{
  "name": "haic-community-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:setup": "docker compose up -d --wait postgres && npm run db:migrate:local",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "test": "DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build BETTER_AUTH_URL=https://haic-hidalgo.org NEXT_PUBLIC_SITE_URL=https://haic-hidalgo.org BETTER_AUTH_SECRET=test-only-secret-with-at-least-32-characters npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:migrate:local": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:export:d1": "node scripts/export-d1.mjs",
    "db:import:postgres": "node scripts/import-postgres.mjs",
    "admin:promote": "node scripts/promote-admin.mjs",
    "config:check": "node --env-file-if-exists=.env.local --experimental-strip-types lib/env.ts",
    "config:check:production": "NODE_ENV=production node --experimental-strip-types lib/env.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.23",
    "better-auth": "^1.6.23",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
